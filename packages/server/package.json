{
  "name": "@zeroback/server",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerodeploy-dev/zeroback",
    "directory": "packages/server"
  },
  "version": "0.0.24",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zeroback/values": "workspace:^",
    "better-auth": "^1.5.6",
    "typeid-js": "^1.2.0"
  },
  "scripts": {
    "build": "bun ../dashboard/scripts/embed.ts && tsc --build --force",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
