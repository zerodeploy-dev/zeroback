{
  "name": "@zeroback/server",
  "author": "Ran Yefet <ran@yefet.net>",
  "version": "0.0.16",
  "description": "Server APIs for Zeroback: schema definition, queries, mutations, actions, HTTP routes, cron jobs, scheduling, and file storage on Cloudflare Workers + Durable Objects + SQLite",
  "keywords": ["zeroback", "server", "cloudflare", "durable-objects", "sqlite", "real-time", "backend", "database", "schema", "convex"],
  "homepage": "https://zeroback.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerodeploy-dev/zeroback",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@zeroback/values": "workspace:^",
    "ulidx": "^2.4.1"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
