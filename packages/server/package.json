{
  "name": "@zeroback/server",
  "version": "0.0.23",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@zeroback/dashboard": "workspace:^",
    "@zeroback/values": "workspace:^",
    "ulidx": "^2.4.1"
  },
  "scripts": {
    "build": "bun ../dashboard/scripts/embed.ts && tsc --build --force",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.1",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
