{
  "name": "@zeroback/react",
  "author": "Ran Yefet <ran@yefet.net>",
  "version": "0.0.16",
  "description": "React hooks for Zeroback: useQuery, useMutation, useAction, usePaginatedQuery with real-time subscriptions",
  "keywords": ["zeroback", "react", "hooks", "real-time", "cloudflare", "websocket", "useQuery", "useMutation"],
  "homepage": "https://zeroback.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerodeploy-dev/zeroback",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@zeroback/client": "workspace:^",
    "@zeroback/server": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
