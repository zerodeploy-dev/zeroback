      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zeroback/client": "workspace:^",
    "@zeroback/server": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": ">=18.3.0",
    "react": ">=18.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
