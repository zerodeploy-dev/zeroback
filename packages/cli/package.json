{
  "name": "@zeroback/cli",
  "author": "Ran Yefet <ran@yefet.net>",
  "version": "0.0.16",
  "description": "CLI for Zeroback: init, dev, deploy, codegen, reset, and run commands for developing and deploying to Cloudflare",
  "keywords": ["zeroback", "cli", "cloudflare", "deploy", "codegen", "developer-tools", "durable-objects"],
  "homepage": "https://zeroback.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerodeploy-dev/zeroback",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "zeroback": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/utils.d.ts",
      "import": "./dist/codegen/utils.js"
    },
    "./analyze": {
      "types": "./dist/analyze/extract.d.ts",
      "import": "./dist/analyze/extract.js"
    },
    "./build": {
      "types": "./dist/build/bundle.d.ts",
      "import": "./dist/build/bundle.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@zeroback/server": "workspace:^",
    "@zeroback/values": "workspace:^",
    "chokidar": "^3.6.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
