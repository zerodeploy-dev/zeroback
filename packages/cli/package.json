{
  "name": "@zeroback/cli",
  "version": "0.0.23",
  "type": "module",
  "bin": {
    "zeroback": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/utils.d.ts",
      "import": "./dist/codegen/utils.js"
    },
    "./analyze": {
      "types": "./dist/analyze/extract.d.ts",
      "import": "./dist/analyze/extract.js"
    },
    "./build": {
      "types": "./dist/build/bundle.d.ts",
      "import": "./dist/build/bundle.js"
    }
  },
  "files": ["dist"],
  "peerDependencies": {
    "@zeroback/server": "workspace:^"
  },
  "dependencies": {
    "@zeroback/server": "workspace:^",
    "@zeroback/values": "workspace:^",
    "chokidar": "^3.6.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
