{
  "name": "zeroback",
  "version": "0.0.1",
  "description": "An open-source Convex-style backend you deploy to your own Cloudflare account. Real-time queries, mutations, type-safe codegen — all running on Cloudflare Workers, Durable Objects, and SQLite.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:all": "bun scripts/publish.js"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0",
    "ulidx": "^2.4.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.67.0",
    "ws": "^8.19.0"
  }
}
