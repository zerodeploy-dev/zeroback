{
  "name": "vex",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "cloudflare/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter='*:*' build",
    "dev": "bun run --filter='*:*' dev",
    "typecheck": "bun run --filter='*:*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.67.0",
    "ws": "^8.19.0"
  }
}
